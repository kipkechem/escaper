--!nonstrict
-- Writes docs/TOWER_MAP.md: the whole tower, floor by floor. Run from the repository root:
--   lune run tools/tower_map.luau

local fs = require("@lune/fs")

local Loader = require("../tests/loader")

local TowerMap = Loader.require("src/shared/TowerMap.luau")
local Tower = Loader.require("src/server/Tower/Tower.luau")

local columns = { "E", "M", "Main", "H" }
local arrows = { [-1] = "↖", [0] = "↑", [1] = "↗" }

local byFloor = {}
local counts = {}
local forks, merges = 0, 0
for _, level in TowerMap.ordered do
	byFloor[level.floor] = byFloor[level.floor] or {}
	byFloor[level.floor][level.staircase] = level
	counts[level.staircase] = (counts[level.staircase] or 0) + 1
	if #level.exits > 1 then
		forks += 1
	end
	if #level.incoming > 1 then
		merges += 1
	end
end

local function cell(level): string
	if not level then
		return ""
	end
	local text = if Tower.isBuilt(level.id) then string.format("**%s** ✅", level.id) else level.id
	if #level.exits > 0 then
		local parts = {}
		for _, exitId in level.exits do
			local direction = TowerMap.levels[exitId].column - level.column
			table.insert(parts, arrows[direction] .. " " .. exitId)
		end
		text ..= " → " .. table.concat(parts, ", ")
	end
	if #level.incoming > 1 then
		text ..= string.format(" (%d ways in)", #level.incoming)
	end
	return text
end

local lines = {
	"# Tower map",
	"",
	"Generated by `lune run tools/tower_map.luau` from `src/shared/TowerMap.luau`. Do not edit by hand.",
	"",
	"Each row is a floor, top floor first. Columns are the staircases, left to right as they",
	"stand in the tower. A cell lists a level and where its exits lead (↖ to the staircase on",
	"the left, ↑ straight up, ↗ to the staircase on the right). A level with several exits has",
	"several solutions. ✅ marks levels that are built.",
	"",
	string.format(
		"%d levels: %d main stair (very hard), %d hard, %d medium, %d easy. %d forks, %d merges.",
		#TowerMap.ordered,
		counts.Main or 0,
		counts.H or 0,
		counts.M or 0,
		counts.E or 0,
		forks,
		merges
	),
	"",
	"| Floor | Easy (E) | Medium (M) | Main stair | Hard (H) |",
	"| ---: | --- | --- | --- | --- |",
}
for floor = TowerMap.TopFloor, 1, -1 do
	local row = { tostring(floor) }
	for _, staircase in columns do
		table.insert(row, cell(byFloor[floor][staircase]))
	end
	table.insert(lines, "| " .. table.concat(row, " | ") .. " |")
end

local problems = TowerMap.validate()
table.insert(lines, "")
if #problems == 0 then
	table.insert(lines, "The map passes every rule in `TowerMap.validate()`.")
else
	table.insert(lines, "**The map breaks these rules:**")
	for _, problem in problems do
		table.insert(lines, "- " .. problem)
	end
end

fs.writeFile("docs/TOWER_MAP.md", table.concat(lines, "\n") .. "\n")
print(string.format("Wrote docs/TOWER_MAP.md (%d levels, %d problems)", #TowerMap.ordered, #problems))
