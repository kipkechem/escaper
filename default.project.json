{
  "name": "escaper",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "RequestGrab": {
          "$className": "RemoteFunction"
        },
        "ReleaseGrab": {
          "$className": "RemoteEvent"
        },
        "Notify": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 7.2,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -200
      }
    },

    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "Ambient": [0.45, 0.45, 0.47],
        "OutdoorAmbient": [0.55, 0.55, 0.58],
        "GlobalShadows": true
      }
    }
  }
}
